# This file was generated using idf.py save-defconfig or menuconfig [D] key. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.6 Project Minimal Configuration
#
# default:
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP_SLEEP_GPIO_RESET_WORKAROUND=n
CONFIG_PM_SLEEP_FUNC_IN_IRAM=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LIBC_OPTIMIZED_MISALIGNED_ACCESS=n

# Preserve the validated production P4 revision and 2 MB firmware layout.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n
CONFIG_ESP32P4_REV_MIN_301=y
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
