{
  "folders": [
    { "name": "master-node", "path": "master-node" },
    { "name": "sensor-node", "path": "sensor-node" },
    { "name": "kernel", "path": "kernel" },
    { "name": "sim-engine-rpm", "path": "simulators/engine-rpm" },
    { "name": "sim-wheel-rpm", "path": "simulators/wheel-rpm" },
    { "name": "repo", "path": "." }
  ],
  "settings": {
    // Build, upload and monitor the project that owns the open file.
    "platformio-ide.activateProjectOnTextEditorChange": true,
    "platformio-ide.toolbar": [
      { "text": "$(home)", "tooltip": "PlatformIO: Home", "commands": "platformio-ide.showHome" },
      { "text": "$(check)", "tooltip": "PlatformIO: Build", "commands": "platformio-ide.build" },
      { "text": "$(arrow-right)", "tooltip": "PlatformIO: Upload and Monitor", "commands": "platformio-ide.uploadAndMonitor" },
      { "text": "$(trashcan)", "tooltip": "PlatformIO: Clean", "commands": "platformio-ide.clean" },
      { "text": "$(plug)", "tooltip": "PlatformIO: Serial Monitor", "commands": "platformio-ide.serialMonitor" },
      { "text": "$(terminal)", "tooltip": "PlatformIO: New Terminal", "commands": "platformio-ide.newTerminal" }
    ],
    // clangd reads the compile commands in target/<package> (each folder's .clangd).
    "C_Cpp.intelliSenseEngine": "disabled",
    // The code has no formatter configuration: never reformat whole files.
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    // The CMakeLists.txt files belong to ESP-IDF; PlatformIO runs the build.
    "cmake.configureOnOpen": false,
    // The projects already have their own folders above.
    "files.exclude": {
      "master-node": true,
      "sensor-node": true,
      "kernel": true,
      "simulators": true,
      "**/.pio": true,
      "**/managed_components": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Decode the open log file to CSV",
        "type": "shell",
        "command": "python3",
        "args": ["${workspaceFolder:master-node}/tools/decode_log.py", "${file}"],
        "problemMatcher": []
      },
      // Ctrl+Shift+B lists them: each builds a firmware, flashes it and opens the monitor.
      { "label": "Flash NodeBrake", "type": "shell", "command": "cargo run --release --bin brake", "options": { "cwd": "${workspaceFolder:sensor-node}" }, "group": "build", "problemMatcher": [] },
      { "label": "Flash NodeMPU", "type": "shell", "command": "cargo run --release --bin mpu", "options": { "cwd": "${workspaceFolder:sensor-node}" }, "group": "build", "problemMatcher": [] },
      { "label": "Flash NodeEncoder", "type": "shell", "command": "cargo run --release --bin encoder", "options": { "cwd": "${workspaceFolder:sensor-node}" }, "group": "build", "problemMatcher": [] },
      { "label": "Flash NodeEngine", "type": "shell", "command": "cargo run --release --bin engine", "options": { "cwd": "${workspaceFolder:sensor-node}" }, "group": "build", "problemMatcher": [] },
      { "label": "Flash NodeEngineBench", "type": "shell", "command": "cargo run --release --bin engine-bench", "options": { "cwd": "${workspaceFolder:sensor-node}" }, "group": "build", "problemMatcher": [] },
      { "label": "Flash NodeADC", "type": "shell", "command": "cargo run --release --bin adc", "options": { "cwd": "${workspaceFolder:sensor-node}" }, "group": "build", "problemMatcher": [] },
      { "label": "Flash Master", "type": "shell", "command": "cargo run --release", "options": { "cwd": "${workspaceFolder:master-node}" }, "group": "build", "problemMatcher": [] },
      { "label": "Flash MasterNoCAN", "type": "shell", "command": "cargo run --release --bin master-no-can", "options": { "cwd": "${workspaceFolder:master-node}" }, "group": "build", "problemMatcher": [] },
      { "label": "Flash EngineRPMSimulator", "type": "shell", "command": "cargo run --release", "options": { "cwd": "${workspaceFolder:sim-engine-rpm}" }, "group": "build", "problemMatcher": [] },
      { "label": "Flash WheelRPMSimulator", "type": "shell", "command": "cargo run --release", "options": { "cwd": "${workspaceFolder:sim-wheel-rpm}" }, "group": "build", "problemMatcher": [] }
    ]
  },
  "extensions": {
    "recommendations": [
      "platformio.platformio-ide",
      "Jason2866.esp-decoder",
      "rust-lang.rust-analyzer",
      "llvm-vs-code-extensions.vscode-clangd"
    ],
    // These conflict with PlatformIO IDE or keep asking to configure CMake.
    "unwantedRecommendations": [
      "pioarduino.pioarduino-ide",
      "espressif.esp-idf-extension",
      "ms-vscode.cmake-tools",
      "ms-vscode.cpptools-extension-pack"
    ]
  }
}
